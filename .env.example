# Copy this file to .env and fill in your own keys.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
# Use the endpoint shown in the console for your key's platform and region.
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# Create a LangSmith API key to use Studio following the official setup guide.
LANGSMITH_API_KEY=
# Set true to send model call traces (including messages) to LangSmith.
LANGSMITH_TRACING=false
