# Copy this file to .env and fill in your own keys.
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash
# Use the endpoint shown in the console for your key's platform and region.
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# Create a LangSmith API key to use Studio following the official setup guide.
LANGSMITH_API_KEY=
# Set true to send model call traces (including messages) to LangSmith.
LANGSMITH_TRACING=false

# Standalone web app: choose your own password (at least 8 characters).
CHAT_PASSWORD=
# Paths are relative to the project, or use an absolute path on your server.
CHAT_DATA_DIR=data/web
# Keep false for local HTTP. Use true behind HTTPS when deploying later.
CHAT_COOKIE_SECURE=false

# Optional: enables web search in both modes. Without it, chat still works.
TAVILY_API_KEY=

# Optional private UTF-8 companion persona file. Relative paths use the project root.
# If unset, use data/companion_prompt.md when present, otherwise the public default.
# Web settings override this file for web chats; Studio uses it by default.
COMPANION_PROMPT_FILE=
